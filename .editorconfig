# EditorConfig — базовые правила редактора (кодировка, отступы, переносы),
# дополняет .clang-format (который отвечает за С++-специфичное форматирование:
# скобки/выравнивание/перенос строк). Visual Studio, Qt Creator, VS Code и
# большинство других редакторов поддерживают EditorConfig "из коробки".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cpp,cc,cxx,h,hpp,hxx,ipp}]
indent_size = 2
max_line_length = 80

[CMakeLists.txt]
indent_size = 2

[*.cmake]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
